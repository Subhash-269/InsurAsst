# Copy to .env (git-ignored) and fill in your key. Real environment variables override this file.

# --- Language model: Google Gemini API (no local GPU needed) -------------------------
# Create a key in Google AI Studio (aistudio.google.com). Questions and policy passages are sent to Google.
LLM_BACKEND=openai
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-3.5-flash-lite
# Optional - this is the default for LLM_BACKEND=openai:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- MLflow (optional) ----------------------------------------------------------------
# Traces and eval runs go to ./mlflow.db by default. View them with: mlflow ui --backend-store-uri sqlite:///mlflow.db
# MLFLOW_TRACING=0                                   # turn request tracing off
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000          # or log to a running MLflow server
# MLFLOW_DISABLE_AGENT_HINT=1                        # hide MLflow's tracing-skill hint in the console
